# ==============================================================================
# Local Business Directory — Environment Configuration Template
# ==============================================================================

# Node Environment (development | test | production)
NODE_ENV=development

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Security Secrets (Must be at least 32 characters in production)
APP_SECRET=your_app_secret_at_least_32_characters_long_here
CRON_SECRET=your_cron_secret_key_here

# PostgreSQL Connection (Pooled connection for serverless / Neon / Supabase / local Docker)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# DIRECT_URL=postgresql://<username>:<password>@<host>:<port>/<database>?schema=public

# Redis Connection (Local Docker or Upstash)
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cloudflare R2 / AWS S3 Compatible Storage
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key
# STORAGE_SECRET_KEY=your_r2_secret_key
STORAGE_BUCKET=directory-media
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:9000/directory-media

# Transactional Email (Resend)
# RESEND_API_KEY=re_123456789
EMAIL_FROM="Local Business Directory <noreply@directory.local>"

# Payment Gateways (Razorpay Primary for INR / Stripe Alternative)
# RAZORPAY_KEY_ID=rzp_test_123456
# RAZORPAY_KEY_SECRET=rzp_secret_key
# RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret
# STRIPE_SECRET_KEY=sk_test_123456
# STRIPE_WEBHOOK_SECRET=whsec_123456

# Bot Protection (Cloudflare Turnstile)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA
# TURNSTILE_SECRET_KEY=0x4AAAAAA

# Map Configuration (leaflet | google)
NEXT_PUBLIC_MAP_PROVIDER=leaflet
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...
